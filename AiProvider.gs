function afResolveProvider_(model){var c=afPrivateProviderConfig_(),p=PropertiesService.getScriptProperties(),name=String(model||'openai/gpt-6.1-sol-pro'),kind='BASS',actual=name;if(/^opencode-go\//i.test(name)){kind='OPENCODE';actual=name.replace(/^opencode-go\//i,'');}else if(/^gemini-/i.test(name))kind='GEMINI';else if(/^openai\/gpt-5($|[\/-])/.test(name))kind='OPENROUTER';else if(/^qwen/i.test(name)&&!/thinking/i.test(name)){kind='QWEN';actual=name.replace(/^qwen\//i,'');}else if(!name.includes('/'))kind='OPENAI';var urlKey=kind==='OPENCODE'?'OPENCODE_GO_URL':kind+'_URL',key=p.getProperty('AF_'+kind+'_API_KEY')||c[kind+'_API_KEY'];if(!key||!c[urlKey])throw Error('AF_AI_PROVIDER_CONFIGURATION_MISSING');return {model:actual,key:key,url:String(c[urlKey]).replace(/\/+$/,'')+'/chat/completions'};}
function afCallAnalyst_(model,prompt){var cfg=afResolveProvider_(model),payload={model:cfg.model,messages:[{role:'system',content:'คุณคือนักวิเคราะห์ Allindy + Fibo ใช้เฉพาะหลักฐานแท่งปิดที่ให้มาและกฎต้นฉบับที่แนบ ไม่ใช้กฎกลยุทธ์อื่น ไม่แต่งข้อมูลที่ยังไม่ทราบ ตอบเป็น JSON object เท่านั้น'},{role:'user',content:prompt}],max_tokens:16384};if(/gpt-6\.1-sol-pro/i.test(model)){payload.reasoning={effort:'medium',exclude:true};payload.verbosity='low';}else{payload.temperature=.2;payload.top_p=.8;}
 var r;try{r=UrlFetchApp.fetch(cfg.url,{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+cfg.key},payload:JSON.stringify(payload),muteHttpExceptions:true,followRedirects:false,validateHttpsCertificates:true});}catch(_){throw Error('AF_AI_REQUEST_FAILED');}if(r.getResponseCode()!==200)throw Error('AF_AI_HTTP_'+r.getResponseCode());var x;try{x=JSON.parse(r.getContentText());}catch(_){throw Error('AF_AI_RESPONSE_INVALID');}var choice=x.choices&&x.choices[0],text=choice&&choice.message&&choice.message.content;if(Array.isArray(text))text=text.map(function(v){return v.text||'';}).join('');if(!text||choice.finish_reason&&choice.finish_reason!=='stop')throw Error('AF_AI_RESPONSE_INCOMPLETE');var decision;try{decision=JSON.parse(String(text).replace(/^\s*```(?:json)?\s*/,'').replace(/\s*```\s*$/,''));}catch(_){throw Error('AF_AI_JSON_INVALID');}return {decision:decision,usage:x.usage||{},cost:x.usage&&typeof x.usage.cost==='number'?x.usage.cost:null};}
