// Exact source rules, used as analyst reference; no 2-more prompt.
var AF_SOURCE_RULES={"allindy":"f_s_momentum(int offsetBars) =>\r\n    float r = ta.rsi(close, 14)\r\n    float raw = ta.stoch(close, high, low, 9)\r\n    float kk = ta.sma(raw, 3)\r\n    float dd = ta.sma(kk, 3)\r\n    bool crossDown = ta.crossunder(kk, dd)\r\n    bool crossUp = ta.crossover(kk, dd)\r\n    bool up20 = ta.crossover(kk, 20.0)\r\n    bool down80 = ta.crossunder(kk, 80.0)\r\n    s_Momentum.new(r[offsetBars], kk[offsetBars], dd[offsetBars], raw[offsetBars], crossDown[offsetBars], crossUp[offsetBars], up20[offsetBars], down80[offsetBars], time[offsetBars], time_close[offsetBars])\r\n\r\nsimple int i_ltfBars = 2600\r\n\n// events. Reaching the terminal stage arms the trigger for subsequent bars.\r\nf_s_nextP(int stage) =>\r\n    switch stage\r\n        0 => s_m5.rsi < 27 or s_m60.k > 40 or s_m240.k > 40 ? 1 : 0\r\n        1 => s_m5.rsi > 32 ? 2 : 1\r\n        2 => s_m5.rsi < 30 ? 3 : 2\r\n        3 => s_m5.k > 20 ? 4 : 3\r\n        4 => s_m5.k < 80 ? 5 : 4\r\n        5 => s_m5.k > 20 or s_m5.rsi < 18 or s_m30.rsi < 18 ? 6 : 5\r\n        6 => s_m5.rsi < 25 ? 7 : 6\r\n        7 => s_m5.rsi > 31 or s_m5.k > 60 ? 8 : s_m15.rsi < 30 ? 4 : 7\r\n        8 => s_m30.rsi > 35 ? 0 : s_m5.k < 20 ? 9 : 8\r\n        9 => s_m1.k < 20 and s_m1.rsi < 30 ? 10 : 9\r\n        => stage\r\n\r\nf_s_nextL1(int stage) =>\r\n    switch stage\r\n        0 => s_m5.rsi < 25 ? 1 : 0\r\n        1 => s_m5.k < 20 ? 2 : 1\r\n        2 => s_m5.k > 80 ? 3 : 2\r\n        3 => s_m5.k < 20 ? 4 : 3\r\n        4 => s_m1.k > 80 ? 5 : 4\r\n        5 => s_m1.k < 20 ? 6 : 5\r\n        6 => s_m5.rsi > 35 ? 7 : 6\r\n        7 => s_m5.rsi < 25 ? 8 : 7\r\n        8 => s_m5.rsi > 33 ? 9 : 8\r\n        9 => s_kdDown5 ? 10 : 9\r\n        10 => s_kUp20_15 ? 11 : 10\r\n        11 => s_m1.k < 20 and s_m1.rsi < 30 ? 12 : 11\r\n        => stage\r\n\r\nf_s_nextL2(int stage) =>\r\n    switch stage\r\n        0 => s_m3.rsi < 25 ? 1 : 0\r\n        1 => s_m3.k < 20 ? 2 : 1\r\n        2 => s_m3.k > 80 ? 3 : 2\r\n        3 => s_m3.k < 20 ? 4 : 3\r\n        4 => s_m1.k > 80 ? 5 : 4\r\n        5 => s_m1.k < 20 ? 6 : 5\r\n        6 => s_m3.rsi > 35 ? 7 : 6\r\n        7 => s_m5.rsi < 25 ? 8 : 7\r\n        8 => s_m5.rsi > 31 ? 9 : 8\r\n        9 => s_kdDown5 ? 10 : 9\r\n        10 => s_kUp20_15 ? 11 : 10\r\n        11 => s_m1.k < 20 and s_m1.rsi < 30 ? 12 : 11\r\n        => stage\r\n\r\nf_s_nextD(int stage) =>\r\n    switch stage\r\n        0 => s_m15.k > 70 ? 1 : 0\r\n        1 => s_m5.rsi > 77 ? 2 : 1\r\n        2 => s_m5.rsi < 69 ? 3 : 2\r\n        // V7 mistakenly reset the long machine here. A renewed >77 extreme\r\n        // now invalidates THIS short setup, before the >72 recovery transition.\r\n        3 => s_m5.rsi > 77 ? 0 : s_m5.rsi > 72 ? 4 : 3\r\n        4 => s_m1.k > 80 ? 5 : 4\r\n        5 => s_m1.k < 20 ? 6 : 5\r\n        6 => s_m1.k > 80 ? 7 : 6\r\n        7 => s_m5.rsi > 75 ? 8 : 7\r\n        8 => s_m5.rsi < 69 ? 9 : 8\r\n        9 => s_m1.k > 80 and s_m1.rsi > 70 ? 10 : 9\r\n        => stage\r\n\r\nf_s_nextS1(int stage) =>\r\n    switch stage\r\n        0 => s_m15.k > 80 ? 1 : 0\r\n        1 => s_m1.rsi > 70 ? 2 : 1\r\n        2 => s_m1.k < 50 ? 3 : 2\r\n        3 => s_m1.rsi < 50 ? 4 : 3\r\n        4 => s_m1.k > 80 ? 5 : 4\r\n        5 => s_m1.k < 79 ? 6 : 5\r\n        6 => s_m15.rsi > 75 ? 7 : 6\r\n        7 => s_m5.rsi > 75 ? 8 : 7\r\n        8 => s_m1.rsi > 75 ? 9 : 8\r\n        9 => s_m1.k > 80 ? 10 : 9\r\n        10 => s_m5.rsi > 75 ? 11 : 10\r\n        11 => s_m5.rsi < 68 ? 12 : 11\r\n        12 => s_kdUp5 ? 13 : 12\r\n        13 => s_kDown80_5 ? 14 : 13\r\n        14 => s_m1.k > 80 and s_m1.rsi > 70 ? 15 : 14\r\n        => stage\r\n\r\nf_s_nextS2(int stage) =>\r\n    switch stage\r\n        0 => s_m1.k > 80 ? 1 : 0\r\n        1 => s_m1.k < 79 ? 2 : 1\r\n        2 => s_m15.rsi > 75 ? 3 : 2\r\n        3 => s_m5.rsi > 75 ? 4 : 3\r\n        4 => s_m5.rsi > 80 ? 5 : 4\r\n        5 => s_m5.rsi < 77 ? 6 : 5\r\n        6 => s_kdUp5 ? 7 : 6\r\n        7 => s_kDown80_5 ? 8 : 7\r\n        8 => s_m1.k > 80 and s_m1.rsi > 70 ? 9 : 8\r\n        => stage\r\n\r\nf_s_tick(s_Machine machine, int nextStage, int terminalStage, bool trigger, bool invalid) =>\r\n    bool fired = false\r\n    if barstate.isconfirmed\r\n        bool expired = machine.stage > 0 and not na(machine.started) and bar_index - machine.started >= s_expiry\r\n        if invalid or expired\r\n            machine.stage := 0\r\n            machine.started := na\r\n        else if machine.stage == terminalStage and trigger\r\n            fired := true\r\n            machine.stage := 0\r\n            machine.started := na\r\n        else\r\n            if machine.stage == 0 and nextStage > 0\r\n                machine.started := bar_index\r\n            if nextStage == 0\r\n                machine.started := na\r\n            machine.stage := nextStage\r\n    fired\r\n\r\nvar s_Machine s_p = s_Machine.new()\r\nvar s_Machine s_l1 = s_Machine.new()\r\nvar s_Machine s_l2 = s_Machine.new()\r\nvar s_Machine s_d = s_Machine.new()\r\nvar s_Machine s_s1 = s_Machine.new()\r\nvar s_Machine s_s2 = s_Machine.new()\r\nbool s_disabled = not s_ebwOn or not s_ebwReady\r\nbool s_fireP = f_s_tick(s_p, f_s_nextP(s_p.stage), 10, s_bullEngulf, s_disabled or s_m30.k > 50 or s_m15.k > 50)\r\nbool s_fireL1 = f_s_tick(s_l1, f_s_nextL1(s_l1.stage), 12, s_bullEngulf, s_disabled or s_m30.rsi > 50 or s_m15.rsi > 70)\r\nbool s_fireL2 = f_s_tick(s_l2, f_s_nextL2(s_l2.stage), 12, s_bullEngulf, s_disabled or s_m30.rsi > 50 or s_m15.rsi > 70)\r\nbool s_fireD = f_s_tick(s_d, f_s_nextD(s_d.stage), 10, s_bearEngulf, s_disabled or s_m15.k < 40 or s_m60.k < 50)\r\nbool s_fireS1 = f_s_tick(s_s1, f_s_nextS1(s_s1.stage), 15, s_bearEngulf, s_disabled or s_m5.rsi < 30 or s_m60.rsi < 50)\r\nbool s_fireS2 = f_s_tick(s_s2, f_s_nextS2(s_s2.stage), 9, s_bearEngulf, s_disabled or s_m15.rsi < 50 or s_m60.rsi < 50)\r\nif barstate.isconfirmed\r\n\n// All history-dependent calculations execute every bar (v6 lazy booleans safe).\r\nfloat s_chartRsi = ta.rsi(close, 14)\r\nfloat s_chartRawK = ta.stoch(close, high, low, 9)\r\nfloat s_esa = ta.ema(hlc3, s_wtChannel)\r\nfloat s_de = ta.ema(math.abs(hlc3 - s_esa), s_wtChannel)\r\nfloat s_ci = not na(s_de) and s_de > 0 ? (hlc3 - s_esa) / (0.015 * s_de) : 0.0\r\nfloat s_wt1 = ta.ema(s_ci, s_wtAverage)\r\nfloat s_wt2 = ta.sma(s_wt1, s_wtSmooth)\r\nbool s_wtCrossUp = ta.crossover(s_wt1, s_wt2)\r\nbool s_wtCrossDown = ta.crossunder(s_wt1, s_wt2)\r\nbool s_originalOverbought = s_chartRsi > 75 and s_chartRawK > 85\r\nbool s_originalOversold = s_chartRsi < 25 and s_chartRawK < 15\r\nfloat s_recentOB = ta.highest(s_originalOverbought ? 1.0 : 0.0, 10)\r\nfloat s_recentOS = ta.highest(s_originalOversold ? 1.0 : 0.0, 10)\r\nbool sigWtEnabled = s_wtOn\r\nbool sigWtLong = s_wtOn and barstate.isconfirmed and s_wtCrossUp and s_wt2 <= -s_wtExtreme and s_recentOS > 0\r\nbool sigWtShort = s_wtOn and barstate.isconfirmed and s_wtCrossDown and s_wt2 >= s_wtExtreme and s_recentOB > 0\r\n\r\n// All six strict orderings of close/Fast/Slow are reachable. Equal values and\r\n// warmup explicitly return Neutral rather than leaving a stale prior phase.\r\nfloat sigFastMA = s_maMethod == \"EMA\" ? ta.ema(close, s_fastLen) : ta.sma(close, s_fastLen)\r\nfloat sigSlowMA = s_maMethod == \"EMA\" ? ta.ema(close, s_slowLen) : ta.sma(close, s_slowLen)\r\nstring i_biasTf = chartSec <= 300 ? \"15\" : chartSec <= 900 ? \"60\" : chartSec <= 3600 ? \"240\" : f_relativeTf(3.0)\r\nf_i_bias() =>\r\n    float fast = s_maMethod == \"EMA\" ? ta.ema(close, s_fastLen) : ta.sma(close, s_fastLen)\r\n    float slow = s_maMethod == \"EMA\" ? ta.ema(close, s_slowLen) : ta.sma(close, s_slowLen)\r\n    [close[1], fast[1], slow[1]]\r\n[i_htfClose, i_htfFast, i_htfSlow] = request.security(syminfo.tickerid, i_biasTf, f_i_bias(), lookahead=barmerge.lookahead_on, calc_bars_count=1200)\r\nbool i_htfL = not i_htfFilter or (i_htfFast > i_htfSlow and i_htfClose > i_htfSlow)\r\nbool i_htfS = not i_htfFilter or (i_htfFast < i_htfSlow and i_htfClose < i_htfSlow)\r\n// Every cross is evaluated every chart bar. A fresh reclaim triggers only at close.\r\nbool i_crossUp = ta.crossover(close, sigFastMA)\r\nbool i_crossDown = ta.crossunder(close, sigFastMA)\r\nbool i_pullL = confirmationRun and barstate.isconfirmed and i_crossUp and low <= sigFastMA and sigFastMA > sigSlowMA and close > open\r\nbool i_pullS = confirmationRun and barstate.isconfirmed and i_crossDown and high >= sigFastMA and sigFastMA < sigSlowMA and close < open\r\nint s_phaseNow = 0\r\nif not na(sigFastMA) and not na(sigSlowMA)\r\n    if sigFastMA > sigSlowMA\r\n        s_phaseNow := close > sigFastMA ? 1 : close > sigSlowMA and close < sigFastMA ? 2 : close < sigSlowMA ? 4 : 0\r\n\nf_z_broken(float lo, float hi, int side, float atrValue, float c, float h, float l) =>\r\n    float probe = z_breakMode == \"Close\" ? c : side == 1 ? l : h\r\n    float buffer = math.max(nz(atrValue, 0.0), syminfo.mintick) * z_breakBuffer\r\n    side == 1 ? probe < lo - buffer : probe > hi + buffer\r\n\r\n// The origin candle is excluded. First departure is not a retest.\r\n// endOffset=1 for prior-source snapshots, 0 for chart-close candidates.\r\nf_z_audit(float lo, float hi, int side, int origin, int startOffset, int endOffset, float atrValue, bool departedAtOrigin) =>\r\n    z_Audit a = z_Audit.new(origin=origin, known=time_close[endOffset], checked=time_close[endOffset], atr=atrValue, seq=bar_index - endOffset, bornSeq=not na(startOffset) ? bar_index - startOffset : na)\r\n    a.complete := not na(startOffset) and startOffset >= endOffset and startOffset <= 300 and not na(atrValue) and atrValue > 0\r\n    if a.complete\r\n        a.complete := not na(time[startOffset])\r\n        a.departed := departedAtOrigin\r\n        if startOffset > endOffset\r\n            for k = startOffset - 1 to endOffset\r\n                if na(close[k]) or na(high[k]) or na(low[k])\r\n                    a.complete := false\r\n                else\r\n                    a.broken := a.broken or f_z_broken(lo, hi, side, atrValue, close[k], high[k], low[k])\r\n                    if not a.departed\r\n                        a.departed := side == 1 ? close[k] > hi : close[k] < lo\r\n                    else\r\n                        bool hit = low[k] <= hi and high[k] >= lo\r\n                        if hit and not a.touching\r\n                            a.tests += 1\r\n                        a.touching := hit\r\n    a\r\n\r\n\nf_z_score(z_Record record) =>\r\n    // Evidence score: zone quality/importance, never a probability of winning.\r\n    float baseQuality = math.max(0.0, math.min(1.0, record.quality)) * 12.0\r\n    float displacement = math.min(1.0, math.max(0.0, record.departureATR) / 1.5) * 20.0\r\n    float structure = f_z_has(record.tags, Z_TAG_STRUCT) ? 16.0 : 0.0\r\n    float sweep = f_z_has(record.tags, Z_TAG_LIQ) ? 10.0 : 0.0\r\n    float freshness = not record.historyComplete or not record.departed ? 0.0 : record.tests == 0 ? 15.0 : record.tests == 1 ? 7.0 : record.tests == 2 ? -8.0 : -20.0\r\n    float htfContext = 0.0 // TF-to-chart weight belongs to relevance, not source quality.\r\n    float breadth = 0.0 // MTF confluence belongs to view priority, never source Q.\r\n    float diversity = math.min(f_z_familyCount(record.families) - 1, 4) * 2.0\r\n    float location = f_z_has(record.tags, Z_TAG_PD) ? 4.0 : 0.0\r\n    float cleanSource = (f_z_has(record.tags, Z_TAG_CLEAN) ? 6.0 : 0.0) + (f_z_has(record.tags, Z_TAG_SOURCE) ? 7.0 : 0.0)\r\n    float qmlBonus = f_z_has(record.families, Z_FAMILY_QML) ? 7.0 : 0.0\r\n    float nestedBonus = f_z_has(record.tags, Z_TAG_NESTED) ? 5.0 : 0.0\r\n    float imbalanceBonus = f_z_has(record.tags, Z_TAG_IMBALANCE) ? 4.0 : 0.0\r\n    float spendingPenalty = record.baseBars <= 2 ? 0.0 : math.min(12.0, (record.baseBars - 2) * 4.0)\r\n    float agePenalty = math.min(10.0, math.max(0, nz(record.sourceSeq - record.sourceBornSeq, 0)) * 10.0 / z_maxAge)\r\n    bool pivotOnly = record.families == Z_FAMILY_PIVOT\r\n    bool impulseOnly = record.families == Z_FAMILY_IMPULSE\r\n    bool swingOnly = record.families == Z_FAMILY_SWING\r\n    bool fvgOnly = record.families == Z_FAMILY_FVG\r\n    bool waveOnly = record.families == Z_FAMILY_WAVE\r\n    float weakFamilyPenalty = pivotOnly ? 15.0 : impulseOnly ? 10.0 : swingOnly ? 6.0 : fvgOnly ? 4.0 : waveOnly ? 6.0 : 0.0\r\n    float raw = baseQuality + displacement + structure + sweep + freshness + htfContext + breadth + diversity + location + cleanSource + qmlBonus + nestedBonus + imbalanceBonus\r\n    if z_scoreModel == \"Grouped evidence\"\r\n        float qualityGroup = math.min(35.0, baseQuality + displacement + cleanSource + imbalanceBonus)\r\n        float structureGroup = math.min(25.0, structure + sweep + qmlBonus)\r\n        float locationGroup = math.min(25.0, htfContext + breadth + diversity + location + nestedBonus)\r\n        raw := qualityGroup + structureGroup + locationGroup + freshness\r\n    math.max(0.0, math.min(100.0, raw - spendingPenalty - agePenalty - weakFamilyPenalty))\r\n\r\nf_z_role(z_Record record, float score) =>\r\n    bool defendCore = f_z_isDefendCore(record)\r\n    bool cleanHtf = f_z_has(record.tags, Z_TAG_CLEAN) and record.departureATR >= 0.75\r\n    bool majorEvidence = f_z_has(record.tags, Z_TAG_SOURCE) or f_z_has(record.tags, Z_TAG_NESTED) or f_z_has(record.families, Z_FAMILY_QML) or cleanHtf or (f_z_has(record.tags, Z_TAG_STRUCT) and f_z_has(record.tags, Z_TAG_DISP))\r\n    f_z_isLiquidityOnly(record) ? Z_ROLE_LIQUIDITY : record.tests >= 2 ? Z_ROLE_REACTION : defendCore and score >= z_majorScore and majorEvidence ? Z_ROLE_MAJOR : Z_ROLE_REACTION\r\n\r\nf_z_roleName(int role) =>\r\n    role == Z_ROLE_MAJOR ? \"MAJOR\" : role == Z_ROLE_REACTION ? \"REACTION\" : \"LIQUIDITY\"\r\n\r\nf_z_actionable(z_Record record, float score) =>\r\n    bool widthOK = record.hi - record.lo <= nz(record.sourceAtr, z_atr) * z_maxWidth\r\n    record.historyComplete and record.departed and widthOK and f_z_isDefendCore(record) and record.tests <= math.min(1, z_maxActionTests) and score >= z_minActionScore\r\n\r\nf_z_reference(z_Record record) =>\r\n    float midpoint = math.avg(record.lo, record.hi)\r\n    record.side == 1 ? (midpoint <= close ? midpoint : record.lo) : (midpoint >= close ? midpoint : record.hi)\r\n\nf_z_data() =>\r\n    float sourceAtr = ta.atr(14)[1]\r\n    float safeAtr = math.max(nz(sourceAtr, high[1] - low[1]), syminfo.mintick)\r\n    float range1 = math.max(high[1] - low[1], syminfo.mintick)\r\n    float range2 = math.max(high[2] - low[2], syminfo.mintick)\r\n    float range3 = math.max(high[3] - low[3], syminfo.mintick)\r\n    float range4 = math.max(high[4] - low[4], syminfo.mintick)\r\n    float body1 = math.abs(close[1] - open[1]) / range1\r\n    float body2 = math.abs(close[2] - open[2]) / range2\r\n    float body3 = math.abs(close[3] - open[3]) / range3\r\n    float body4 = math.abs(close[4] - open[4]) / range4\r\n\r\n    // Canonical one-base S/D patterns from FXTA terminology.\r\n    bool compactBase = body2 <= 0.35\r\n    bool leaveBull = close[1] > open[1] and body1 >= 0.52 and close[1] > high[2]\r\n    bool leaveBear = close[1] < open[1] and body1 >= 0.52 and close[1] < low[2]\r\n    bool rbr = compactBase and close[3] > open[3] and leaveBull\r\n    bool dbr = compactBase and close[3] < open[3] and leaveBull\r\n    bool rbd = compactBase and close[3] > open[3] and leaveBear\r\n    bool dbd = compactBase and close[3] < open[3] and leaveBear\r\n\r\n    // Keep the earlier multi-candle patterns as secondary candidates so useful history is not lost.\r\n    bool fiveDemand = close[5] > open[5] and close[4] < open[4] and close[3] < open[3] and close[2] > open[2] and close[1] > open[1]\r\n    bool fiveSupply = close[5] < open[5] and close[4] > open[4] and close[3] > open[3] and close[2] < open[2] and close[1] < open[1]\r\n    bool threeDemand = close[3] > open[3] and (compactBase or close[2] < open[2]) and close[1] > open[1] and low[1] > low[2] and close[1] > high[2]\r\n    bool threeSupply = close[3] < open[3] and (compactBase or close[2] > open[2]) and close[1] < open[1] and high[1] < high[2] and close[1] < low[2]\r\n    bool weak4 = body4 < 0.30\r\n    bool strongDemand = (close[4] < open[4] or weak4) and close[3] - open[3] > range3 * 0.60 and close[2] > open[2] and close[2] > close[3] and low[3] > low[4]\r\n    bool strongSupply = (close[4] > open[4] or weak4) and open[3] - close[3] > range3 * 0.60 and close[2] < open[2] and close[2] < close[3] and high[3] < high[4]\r\n\r\n    bool primaryDemand = rbr or dbr\r\n    bool primarySupply = rbd or dbd\r\n    float demandLo = (primaryDemand or threeDemand) ? low[2] : fiveDemand ? math.min(low[4], low[3]) : strongDemand ? low[3] : na\r\n    float demandHi = (primaryDemand or threeDemand) ? math.max(open[2], close[2]) : fiveDemand ? math.max(math.max(open[4], close[4]), math.max(open[3], close[3])) : strongDemand ? open[3] : na\r\n    float supplyHi = (primarySupply or threeSupply) ? high[2] : fiveSupply ? math.max(high[4], high[3]) : strongSupply ? high[3] : na\r\n    float supplyLo = (primarySupply or threeSupply) ? math.min(open[2], close[2]) : fiveSupply ? math.min(math.min(open[4], close[4]), math.min(open[3], close[3])) : strongSupply ? open[3] : na\r\n    int demandStamp = not na(demandLo) ? time[1] : na\r\n    int supplyStamp = not na(supplyLo) ? time[1] : na\r\n    int demandKind = rbr ? 1 : dbr ? 2 : not na(demandLo) ? 3 : 0\r\n    int supplyKind = rbd ? 1 : dbd ? 2 : not na(supplyLo) ? 3 : 0\r\n    int demandBaseBars = fiveDemand and not primaryDemand and not threeDemand ? 2 : not na(demandLo) ? 1 : 0\r\n    int supplyBaseBars = fiveSupply and not primarySupply and not threeSupply ? 2 : not na(supplyLo) ? 1 : 0\r\n    float demandDeparture = na(demandHi) ? 0.0 : math.max(0.0, high[1] - demandHi) / safeAtr\r\n    float supplyDeparture = na(supplyLo) ? 0.0 : math.max(0.0, supplyLo - low[1]) / safeAtr\r\n    bool demandSweep = not na(demandLo) and low[2] < math.min(low[3], low[4])\r\n    bool supplySweep = not na(supplyHi) and high[2] > math.max(high[3], high[4])\r\n    float priorStructureHigh = math.max(high[3], math.max(high[4], high[5]))\r\n    float priorStructureLow = math.min(low[3], math.min(low[4], low[5]))\r\n    bool demandStructure = not na(demandHi) and close[1] > priorStructureHigh\r\n    bool supplyStructure = not na(supplyLo) and close[1] < priorStructureLow\r\n\r\n    // Confirmed pivot registry for trend, QML, equal highs/lows and premium/discount.\r\n    float pivotHigh = ta.pivothigh(high, 3, 3)\r\n    float pivotLow = ta.pivotlow(low, 3, 3)\r\n    float h0 = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)[1]\r\n    float h1 = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)[1]\r\n    float l0 = ta.valuewhen(not na(pivotLow), pivotLow, 0)[1]\r\n    float l1 = ta.valuewhen(not na(pivotLow), pivotLow, 1)[1]\r\n    int h0t = ta.valuewhen(not na(pivotHigh), time[3], 0)[1]\r\n    int h1t = ta.valuewhen(not na(pivotHigh), time[3], 1)[1]\r\n    int l0t = ta.valuewhen(not na(pivotLow), time[3], 0)[1]\r\n    int l1t = ta.valuewhen(not na(pivotLow), time[3], 1)[1]\r\n    bool haveRange = not na(h0) and not na(l0) and h0 > l0\r\n    float equilibrium = haveRange ? math.avg(h0, l0) : na\r\n    bool demandPD = haveRange and not na(demandHi) and demandHi <= equilibrium\r\n    bool supplyPD = haveRange and not na(supplyLo) and supplyLo >= equilibrium\r\n\r\n    float demandBaseQuality = primaryDemand ? 1.0 - body2 : fiveDemand ? 1.0 - (body3 + body4) * 0.5 : threeDemand ? 1.0 - body2 : strongDemand ? 1.0 - body4 : 0.0\r\n    float supplyBaseQuality = primarySupply ? 1.0 - body2 : fiveSupply ? 1.0 - (body3 + body4) * 0.5 : threeSupply ? 1.0 - body2 : strongSupply ? 1.0 - body4 : 0.0\r\n    bool demandClean = not na(demandLo) and demandDeparture >= 0.75 and demandBaseBars <= 2\r\n    bool supplyClean = not na(supplyLo) and supplyDeparture >= 0.75 and supplyBaseBars <= 2\r\n    bool demandSource = demandClean and demandStructure and demandDeparture >= 0.90\r\n    bool supplySource = supplyClean and supplyStructure and supplyDeparture >= 0.90\r\n    float demandQuality = math.max(0.0, math.min(1.0, 0.38 + demandBaseQuality * 0.38 + (demandStructure ? 0.10 : 0.0) + (demandSweep ? 0.08 : 0.0) + (primaryDemand ? 0.06 : 0.0)))\r\n    float supplyQuality = math.max(0.0, math.min(1.0, 0.38 + supplyBaseQuality * 0.38 + (supplyStructure ? 0.10 : 0.0) + (supplySweep ? 0.08 : 0.0) + (primarySupply ? 0.06 : 0.0)))\r\n    int demandTags = (demandDeparture >= 0.60 ? Z_TAG_DISP : 0) + (demandSweep ? Z_TAG_LIQ : 0) + (demandStructure ? Z_TAG_STRUCT : 0) + (demandPD ? Z_TAG_PD : 0) + (demandClean ? Z_TAG_CLEAN : 0) + (demandSource ? Z_TAG_SOURCE : 0) + (low[1] > high[3] ? Z_TAG_IMBALANCE : 0)\r\n    int supplyTags = (supplyDeparture >= 0.60 ? Z_TAG_DISP : 0) + (supplySweep ? Z_TAG_LIQ : 0) + (supplyStructure ? Z_TAG_STRUCT : 0) + (supplyPD ? Z_TAG_PD : 0) + (supplyClean ? Z_TAG_CLEAN : 0) + (supplySource ? Z_TAG_SOURCE : 0) + (high[1] < low[3] ? Z_TAG_IMBALANCE : 0)\r\n\r\n    // Three-candle FVG/imbalance stays an independent reaction layer, not a defend-core MTF vote.\r\n    bool bullFvg = low[1] > high[3]\r\n    bool bearFvg = high[1] < low[3]\r\n    float bullFvgLo = bullFvg ? high[3] : na\r\n    float bullFvgHi = bullFvg ? low[1] : na\r\n    float bearFvgLo = bearFvg ? high[1] : na\r\n    float bearFvgHi = bearFvg ? low[3] : na\r\n    float bullFvgDeparture = bullFvg ? (low[1] - high[3]) / safeAtr : 0.0\r\n    float bearFvgDeparture = bearFvg ? (low[3] - high[1]) / safeAtr : 0.0\r\n\r\n    // Quasimodo approximation from four confirmed alternating pivots.\r\n    bool commonQmShape = not na(h0) and not na(h1) and not na(l0) and not na(l1) and not na(h0t) and not na(h1t) and not na(l0t) and not na(l1t) and h0 > h1 and l0 < l1\r\n    bool bullQm = commonQmShape and l1t < h1t and h1t < l0t and l0t < h0t\r\n    bool bearQm = commonQmShape and h1t < l1t and l1t < h0t and h0t < l0t\r\n    float bullQml = bullQm ? l1 : na\r\n    float bearQml = bearQm ? h1 : na\r\n    int bullQmlStamp = bullQm ? h0t : na\r\n    int bearQmlStamp = bearQm ? l0t : na\r\n    float bullQmlDeparture = bullQm ? math.max(0.0, h0 - h1) / safeAtr : 0.0\r\n    float bearQmlDeparture = bearQm ? math.max(0.0, l1 - l0) / safeAtr : 0.0\r\n    bool bullNested = bullQm and not na(demandLo) and bullQml >= demandLo - safeAtr * 0.10 and bullQml <= demandHi + safeAtr * 0.10\r\n    bool bearNested = bearQm and not na(supplyLo) and bearQml >= supplyLo - safeAtr * 0.10 and bearQml <= supplyHi + safeAtr * 0.10\r\n    int bullQmlTags = Z_TAG_STRUCT + (bullQmlDeparture >= 0.60 ? Z_TAG_DISP : 0) + (haveRange and bullQml <= equilibrium ? Z_TAG_PD : 0) + (bullNested ? Z_TAG_NESTED : 0)\r\n    int bearQmlTags = Z_TAG_STRUCT + (bearQmlDeparture >= 0.60 ? Z_TAG_DISP : 0) + (haveRange and bearQml >= equilibrium ? Z_TAG_PD : 0) + (bearNested ? Z_TAG_NESTED : 0)\r\n\r\n    // Equal highs/lows are explicit liquidity pools, not defend zones.\r\n    float eqTol = safeAtr * 0.16\r\n    bool equalHigh = not na(h0) and not na(h1) and not na(h0t) and not na(h1t) and h0t != h1t and math.abs(h0 - h1) <= eqTol\r\n    bool equalLow = not na(l0) and not na(l1) and not na(l0t) and not na(l1t) and l0t != l1t and math.abs(l0 - l1) <= eqTol\r\n    float eqHigh = equalHigh ? math.avg(h0, h1) : na\r\n    float eqLow = equalLow ? math.avg(l0, l1) : na\r\n    int eqHighStamp = equalHigh ? math.max(h0t, h1t) : na\r\n    int eqLowStamp = equalLow ? math.max(l0t, l1t) : na\r\n\r\n    // Valid-pullback style inducement: a local probe followed by overlap/close through the prior candle.\r\n    bool bullIdm = low[2] < low[3] and close[1] > high[2]\r\n    bool bearIdm = high[2] > high[3] and close[1] < low[2]\r\n    float idmLow = bullIdm ? low[2] : na\r\n    float idmHigh = bearIdm ? high[2] : na\r\n    int idmLowStamp = bullIdm ? time[1] : na\r\n    int idmHighStamp = bearIdm ? time[1] : na\r\n\r\n    // 50% of wave in an established HH/HL or LH/LL context. Context layer only.\r\n    bool upTrend = not na(h0) and not na(h1) and not na(l0) and not na(l1) and h0 > h1 and l0 > l1\r\n    bool downTrend = not na(h0) and not na(h1) and not na(l0) and not na(l1) and h0 < h1 and l0 < l1\r\n    float wave50 = haveRange ? math.avg(h0, l0) : na\r\n    int waveStamp = haveRange ? math.max(h0t, l0t) : na\r\n    float wave50Demand = upTrend and close[1] >= wave50 ? wave50 : na\r\n    float wave50Supply = downTrend and close[1] <= wave50 ? wave50 : na\r\n\r\n    int demandOffset = primaryDemand or threeDemand ? 2 : fiveDemand ? 4 : strongDemand ? 3 : na\r\n\n\r\nf_r_protectiveAnchor(z_Record core) =>\r\n    float best = na\r\n    float bestGap = -1.0\r\n    if array.size(z_records) > 0 and not na(z_atr) and z_atr > 0\r\n        for i = 0 to array.size(z_records) - 1\r\n            z_Record record = array.get(z_records, i)\r\n            if record.side == core.side and f_z_isLiquidityOnly(record)\r\n                float candidate = core.side == 1 ? record.lo : record.hi\r\n                float gap = core.side == 1 ? core.lo - candidate : candidate - core.hi\r\n                // Use the deepest mapped liquidity/swing anchor inside the protection window.\r\n                // This avoids parking the stop just behind the first shallow SSL/BSL that can be swept.\r\n                if gap >= 0 and gap <= z_atr * v10_anchorSearchATR and gap > bestGap\r\n                    best := candidate\r\n                    bestGap := gap\r\n    best\r\n\r\nf_r_sweepBufferATR(z_Record core, float anchor) =>\r\n    float result = v10_invalidBuffer\r\n    if not na(anchor) and not na(z_atr) and z_atr > 0\r\n        float distal = core.side == 1 ? core.lo : core.hi\r\n        float anchorGapATR = math.abs(distal - anchor) / z_atr\r\n        if anchorGapATR <= v10_sweepRiskATR\r\n            result := math.max(result, v10_sweepBufferATR)\r\n    result\r\n\r\nf_r_adaptiveDepth(z_Record record, float anchor) =>\r\n    float score = f_z_cachedScore(record)\r\n    int role = f_z_cachedRole(record, score)\r\n    float depth = record.tests == 0 ? (role == Z_ROLE_MAJOR ? (score >= 90 ? 0.28 : 0.33) : score >= 70 ? 0.45 : 0.52) : role == Z_ROLE_MAJOR ? 0.50 : 0.58\r\n    float distal = record.side == 1 ? record.lo : record.hi\r\n    float extension = na(anchor) or na(z_atr) or z_atr <= 0 ? 0.0 : math.abs(distal - anchor) / z_atr\r\n    math.min(0.65, depth + math.min(0.12, extension * 0.08))\r\n\r\nf_r_entryFromPOI(z_Record record, float anchor) =>\r\n    float depth = f_r_adaptiveDepth(record, anchor)\r\n    record.side == 1 ? record.hi - depth * (record.hi - record.lo) : record.lo + depth * (record.hi - record.lo)\r\n\r\nf_r_directLimitOK(z_Record record) =>\r\n    float score = f_z_cachedScore(record)\r\n    int role = f_z_cachedRole(record, score)\r\n    role == Z_ROLE_MAJOR ? record.tests <= 1 : role == Z_ROLE_REACTION and score >= 70 and record.tests == 0\r\n\r\nf_r_nearer(float a, float b, float entry) =>\r\n\nf_i_plan(int side, int index) =>\r\n    i_Plan p = i_Plan.new()\r\n    if index >= 0 and i_atrReady\r\n        z_Record core = array.get(z_records, index)\r\n        p.entry := math.round_to_mintick(close)\r\n        float mappedAnchor = f_r_protectiveAnchor(core)\r\n        float anchor = side == 1 ? math.min(math.min(core.lo, low), na(mappedAnchor) ? core.lo : mappedAnchor) : math.max(math.max(core.hi, high), na(mappedAnchor) ? core.hi : mappedAnchor)\r\n        float adaptiveBufferATR = math.max(i_stopBuffer, f_r_sweepBufferATR(core, mappedAnchor))\r\n        float buffer = math.max(syminfo.mintick * 2.0, i_prevATR * adaptiveBufferATR)\r\n        float rawStop = side == 1 ? math.min(anchor - buffer, p.entry - i_prevATR * i_minStopATR) : math.max(anchor + buffer, p.entry + i_prevATR * i_minStopATR)\r\n        p.stop := f_r_round(rawStop, side == -1)\r\n        float risk = (p.entry - p.stop) * side\r\n        float obstacle = f_x_obstacle(side, p.entry)\r\n        float liquidity = f_r_structuralTarget(side, p.entry, 1, 0.0)\r\n        float mapped = f_r_nearer(liquidity, na(obstacle) ? na : p.entry + side * obstacle, p.entry)\r\n        if not na(mapped) and risk > 0\r\n            float capped = side == 1 ? math.min(mapped, p.entry + risk * i_targetR) : math.max(mapped, p.entry - risk * i_targetR)\r\n            p.target := f_r_round(capped, side == -1)\r\n        float reward = (p.target - p.entry) * side\r\n        p.netR := not na(reward) and risk > 0 ? (reward - i_cost) / (risk + i_cost) : na\r\n        p.reason := core.side != side ? \"WRONG POI SIDE\" : risk < syminfo.mintick ? \"INVALID SL\" : risk > i_prevATR * i_maxStopATR ? \"STOP TOO WIDE\" : not na(obstacle) and (obstacle < syminfo.mintick or (x_spaceFilter and obstacle < i_prevATR * x_minSpace)) ? \"OBSTACLE TOO CLOSE\" : na(p.target) ? \"NO MAPPED TARGET\" : reward < math.max(syminfo.mintick, i_prevATR * v10_minRoomATR) ? \"TARGET TOO CLOSE\" : na(p.netR) or p.netR + 1e-9 < i_minNetR ? \"NET RR TOO LOW\" : \"OK\"\r\n    p\r","fibo":"    Point event = Point.new()\n    int zone = osc <= os ? -1 : osc >= ob ? 1 : 0\n    if e.kind != 0\n        bool newExtreme = e.kind == -1 ? low < e.p : high > e.p\n        if newExtreme\n            e.p := e.kind == -1 ? low : high\n            e.r := rr\n            e.t := time\n            e.i := bar_index\n            e.trigger := e.kind == -1 ? high[1] : low[1]\n            e.closeT := time_close\n        if zone != e.kind\n            event := Point.new(e.kind, e.p, e.r, e.t, e.i, e.trigger, e.closeT)\n            e.kind := 0\n    if e.kind == 0 and zone != 0\n        e.kind := zone\n        e.p := zone == -1 ? low : high\n        e.r := rr\n        e.t := time\n        e.i := bar_index\n        e.trigger := zone == -1 ? high[1] : low[1]\n        e.closeT := time_close\n    event\n\n// A Stochastic head starts in OS/OB and ends BEFORE the first opposite-zone\n// candle. Neutral-zone price extremes still belong to this developing head.\n// Its first exit confirms one point for Form/TS; later price refinements only\n// update the sequence for FUTURE Forms. Copied Frame/plan anchors never move.\n// Re-entering the same zone is not a fresh cycle and cannot resurrect a Form.\ntype SwingHead\n    int kind = 0\n    float p = na\n    float r = na\n    int t = na\n    int i = na\n    float trigger = na\n    int closeT = na\n    int cycle = na\n    bool announced = false\n\nmethod track(SwingHead head, float osc, float os, float ob, float rr) =>\n    Point event = Point.new()\n    bool ready = not na(osc) and not na(high) and not na(low)\n    int zone = not ready ? 0 : osc <= os ? -1 : osc >= ob ? 1 : 0\n    if ready\n        bool opposite = head.kind != 0 and zone == -head.kind\n        if opposite and not head.announced\n            // A direct OB->OS / OS->OB jump confirms the previous head once.\n            // Never put BOTH extrema on the transition candle: OHLC has no order.\n            event := Point.new(head.kind, head.p, head.r, head.t, head.i, head.trigger, head.closeT, head.cycle, true)\n        if head.kind == 0 or opposite\n            if zone != 0\n                head.kind := zone\n                head.p := zone == -1 ? low : high\n                head.r := rr\n                head.t := time\n                head.i := bar_index\n                head.trigger := zone == -1 ? high[1] : low[1]\n                head.closeT := time_close\n                head.cycle := time\n                head.announced := false\n        else\n            bool newExtreme = head.kind == -1 ? low < head.p : high > head.p\n            if newExtreme\n                head.p := head.kind == -1 ? low : high\n                head.r := rr\n                head.t := time\n                head.i := bar_index\n                head.trigger := head.kind == -1 ? high[1] : low[1]\n                head.closeT := time_close\n            bool firstExit = not head.announced and zone == 0\n            if firstExit or (head.announced and newExtreme)\n                event := Point.new(head.kind, head.p, head.r, head.t, head.i, head.trigger, head.closeT, head.cycle, firstExit)\n            if firstExit\n                head.announced := true\n    event\n\nf_push(array<Point> seq, Point event, int maxPoints = 6) =>\n    bool changed = false\n    if event.kind != 0\n        int n = seq.size()\n        if n > 0 and seq.get(n - 1).kind == event.kind\n            Point old = seq.get(n - 1)\n            bool better = event.kind == -1 ? event.p < old.p : event.p > old.p\n            if better\n                seq.set(n - 1, f_copy(event))\n                changed := true\n        else\n            seq.push(f_copy(event))\n            if seq.size() > maxPoints\n                seq.shift()\n            changed := true\n    changed\n\n// Read source-TF candle wicks, not the oscillator value at a different candle.\n// RSI is assigned by f_engine, whose rr series is evaluated on every bar.\nmethod capture(Point point, float price, int historyOffset) =>\n    point.p := price\n    point.r := na\n    point.t := time[historyOffset]\n    point.i := bar_index - historyOffset\n    point.trigger := point.kind == -1 ? high[historyOffset + 1] : low[historyOffset + 1]\n    point.closeT := time_close[historyOffset]\n    point\n\nf_pick_set(array<Point> seq) =>\n    SwingSet picked = SwingSet.new(a = Point.new(), b = Point.new(), c = Point.new(), ref = Point.new())\n    int count = seq.size()\n    if count >= 3\n        Point lastHead = seq.get(count - 1)\n        int side = lastHead.kind == -1 ? 1 : -1\n        int rootSlot = count - 3\n        bool intactRoot = false\n        bool rootTooOld = false\n        // Prefer the NEAREST same-kind root that C has not broken. An inner\n        // higher high/lower low does not replace the still-intact outer set.\n        // If none exists, retain the original three-point neck candidate;\n        // its RSI-divergence/context checks remain in f_engine.\n        for hop = 0 to int((count - 3) / 2)\n            int slot = count - 3 - hop * 2\n            Point root = seq.get(slot)\n            if not na(root.i) and root.kind == lastHead.kind and root.i < lastHead.i and side * (lastHead.p - root.p) >= 0\n                if bar_index - root.i < 1999\n                    rootSlot := slot\n                    intactRoot := true\n                else\n                    // Missing the outer window is NOT permission to fall back\n                    // to the very same tiny neck that this revision removes.\n                    rootTooOld := true\n                break\n        Point firstHead = seq.get(rootSlot)\n        Point counterHead = seq.get(rootSlot + 1)\n        bool bounded = not rootTooOld and not na(firstHead.i) and not na(lastHead.i) and firstHead.i >= 0 and firstHead.i < lastHead.i and lastHead.i <= bar_index and bar_index - firstHead.i < 1999\n        if bounded\n            Point a = f_copy(firstHead)\n            Point b = Point.new(kind = counterHead.kind, cycle = counterHead.cycle, confirmed = true)\n            Point c = Point.new(kind = lastHead.kind, cycle = lastHead.cycle, confirmed = true)\n            bool historyKnown = true\n            // Closed interval A..C only. NEVER scan into the post-C target leg.\n            // One chronological pass keeps the true outer wick and resets B/C\n            // when A extends, or C when B extends. Equal prices keep first time.\n            for candleIndex = firstHead.i to lastHead.i\n                int offset = bar_index - candleIndex\n                if na(high[offset]) or na(low[offset]) or na(time[offset]) or na(time_close[offset])\n                    historyKnown := false\n                    break\n                float headPrice = lastHead.kind == 1 ? high[offset] : low[offset]\n                float counterPrice = counterHead.kind == 1 ? high[offset] : low[offset]\n                bool rootExtends = intactRoot and (lastHead.kind == 1 ? headPrice > a.p : headPrice < a.p)\n                if rootExtends\n                    a.capture(headPrice, offset)\n                    b.p := na\n                    c.p := na\n                bool counterExtends = na(b.p) or (counterHead.kind == 1 ? counterPrice > b.p : counterPrice < b.p)\n                if counterExtends\n                    b.capture(counterPrice, offset)\n                    c.capture(headPrice, offset)\n                else if na(c.p) or (lastHead.kind == 1 ? headPrice > c.p : headPrice < c.p)\n                    c.capture(headPrice, offset)\n            bool alternating = a.kind == c.kind and b.kind == -c.kind\n            bool ordered = not na(b.i) and not na(c.i) and a.i < b.i and b.i < c.i and a.t < b.t and b.t < c.t\n            bool geometry = side * (b.p - a.p) > 0 and side * (b.p - c.p) > 0\n            if historyKnown and alternating and ordered and geometry\n                // D must precede the actual selected A, including an extended A.\n                Point ref = Point.new()\n                for back = 1 to count\n                    Point prior = seq.get(count - back)\n                    if prior.kind == -a.kind and prior.i < a.i\n                        ref := f_copy(prior)\n                        break\n                picked := SwingSet.new(true, a, b, c, ref)\n    picked\n\nf_breached(int side, float zero) =>\n    side == 1 ? low < zero : side == -1 ? high > zero : false\n\nf_break(int side, float boundary) =>\n    float observed = breakMode == \"Close ของแท่งปิด\" ? close : side == 1 ? high : low\n    side == 1 ? observed > boundary : observed < boundary\n\nf_gauge(Point ref, Point a, Point b, int side) =>\n    bool valid = not na(ref.p) and ref.t < a.t and side * (ref.p - a.p) > 0 and side * (b.p - a.p) > 0\n    valid ? math.abs(b.p - a.p) / math.abs(ref.p - a.p) : na\n\nf_method(Frame frame) =>\n    // E/N differ only in structural classification, both measure B->C.\n    frame.neck ? 3 : 1\n\n// BEGIN BOOK LIFECYCLE\nf_bookDead(int side, float boundary) =>\n\n    // Each target dies at its own zero OR its protected root; no anchor is moved.\n    // A failed C does not kill the larger A-root that can host a NEW confirmed Form.\n    f_familyAdvance(familyUp)\n    f_familyAdvance(familyDn)\n    if bookUp.valid and f_bookDead(1, bookUp.origin)\n        bookUp := BookRoot.new()\n    if bookDn.valid and f_bookDead(-1, bookDn.origin)\n        bookDn := BookRoot.new()\n    if bookRecords.size() > 0\n        for i = bookRecords.size() - 1 to 0\n            BookTarget old = bookRecords.get(i)\n            if f_bookDead(old.side, old.zero) or f_bookDead(old.side, old.rootPrice)\n                out.invalid := old.side\n                if old.born == latestTargetBorn\n                    latestStatus := 4\n                bookRecords.remove(i)\n            else if f_bookActive(old)\n                old.legLow := math.min(old.legLow, low)\n                old.legHigh := math.max(old.legHigh, high)\n                old.asof := time_close\n                if time > old.born\n                    float extreme = old.side == 1 ? high : low\n                    f_bookAdvance(old, extreme, time_close)\n    if bull.stage > 0 and f_bookDead(1, bull.c.p)\n        usedBull := bull.c.cycle\n        bull.stage := 0\n    if bear.stage > 0 and f_bookDead(-1, bear.c.p)\n        usedBear := bear.c.cycle\n\n                lowHold := false\n            SwingSet picked = f_pick_set(kseq)\n            if picked.valid\n                Point a = picked.a\n                Point b = picked.b\n                Point c = picked.c\n                Point ref = picked.ref\n                a.r := rr[bar_index - a.i]\n                b.r := rr[bar_index - b.i]\n                c.r := rr[bar_index - c.i]\n                bool held = side * (c.p - a.p) >= 0\n                bool sameRSI = side == 1 ? na(lastROB) or lastROB < a.t : na(lastROS) or lastROS < a.t\n                bool neck = not held and sameRSI and side * (c.r - a.r) > 0\n                bool initialContext = side == 1 ? a.r <= rOS or rBias == 1 or divState == 1 : a.r >= rOB or rBias == -1 or divState == -1\n                BookRoot root = side == 1 ? bookUp : bookDn\n                bool rootContext = root.valid and a.t >= root.id and side * (c.p - root.origin) >= 0\n                BookFamily family = side == 1 ? familyUp : familyDn\n                int role = 0\n                int mainId = na\n                bool candidate = not f_breached(side, c.p) and ((held and (initialContext or rootContext)) or (allowNeck and neck))\n                if candidate\n                    int priorRole = -1\n                    if bookRecords.size() > 0\n                        for old in bookRecords\n                            if old.side == side and old.id == c.t\n                                priorRole := old.role\n                                mainId := old.mainId\n                                break\n                    if priorRole >= 0\n                        role := priorRole\n                    else\n                        role := f_familyRole(family, a, b, c, neck)\n                        if not neck\n                            if not family.valid or (role == 0 and (not f_familySame(family, a, c) or na(family.breakT) and family.id != c.t))\n                                f_familySeed(family, a, b, c, side)\n                            mainId := family.id\n                            if side == 1\n                                familyUp := family\n                            else\n                                familyDn := family\n                    if not rootContext or (root.neck and not neck)\n                        root := f_bookRoot(a, b, c, side, neck)\n                    else\n                        root.lo := math.min(root.lo, math.min(math.min(a.p, b.p), c.p))\n                        root.hi := math.max(root.hi, math.max(math.max(a.p, b.p), c.p))\n                    if side == 1\n                        bookUp := root\n                    else\n                        bookDn := root\n                if side == 1 and candidate and (na(usedBull) or c.cycle != usedBull)\n                    bull := Frame.new(1, 1, neck, role, f_copy(a), f_copy(b), f_copy(c), f_copy(ref), na, time, mainId)\n                    if chartContext and overrideD\n                        bull.ref := Point.new(1, manualD, na, manualDT, na, na)\n                    bull.gauge := f_gauge(bull.ref, a, b, 1)\n                else if side == -1 and candidate and (na(usedBear) or c.cycle != usedBear)\n\n\n    // Invalidate before break; reject bars touching both boundaries.\n    bool bullBreak = bull.stage == 1 and time > bull.c.t and not f_breached(1, bull.c.p) and f_break(1, bull.b.p)\n    bool bearBreak = bear.stage == 1 and time > bear.c.t and not f_breached(-1, bear.c.p) and f_break(-1, bear.b.p)\n    if bullBreak and bearBreak\n        bull.stage := 0\n        bear.stage := 0\n        usedBull := bull.c.cycle\n        usedBear := bear.c.cycle\n        bullBreak := false\n        bearBreak := false\n    if bullBreak or bearBreak\n        Frame chosen = bullBreak ? bull : bear\n        int method = f_method(chosen)\n        int side = chosen.side\n        chosen.stage := 2\n        out.broke := side\n        out.cut := chosen.c.p\n        if side == 1\n            usedBull := chosen.c.cycle\n        else\n            usedBear := chosen.c.cycle\n        // Every valid broken Form uses B->C; Gauge never changes the method.\n        if method != 0 and side != 0\n            // A later same-source A/B/C with confirmed opposite Break can take over.\n            // Pending Form, first-target touch or an oscillator cross alone cannot.\n            if bookRecords.size() > 0\n                for old in bookRecords\n                    float firstTarget = old.method == 3 ? 1.618 : 2.618\n                    bool laterLeg = chosen.a.t >= old.born and chosen.b.t > chosen.a.t and chosen.c.t > chosen.b.t\n                    if f_bookActive(old) and old.side == -side and not na(f_bookHitTime(old, firstTarget)) and laterLeg\n                        old.closedT := time_close\n                        old.closedKind := 2\n                        if old.side == 1 and old.id == familyUp.id\n                            familyUp.valid := false\n                        if old.side == -1 and old.id == familyDn.id\n                            familyDn.valid := false\n            BookRoot root = side == 1 ? bookUp : bookDn\n            BookFamily family = side == 1 ? familyUp : familyDn\n            if family.valid and chosen.role == 0 and chosen.mainId == family.id and na(family.breakT)\n                family.breakT := time_close\n            f_bookAdd(bookRecords, f_bookCapture(chosen, root, contextATR))"};
